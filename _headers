# Netlify headers (works for Git builds and drag-and-drop deploys).
# Hashed build files never change, so browsers can keep them for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Optimized images keep their names when replaced, so cache them for a week.
/images/opt/*
  Cache-Control: public, max-age=604800
